NODE_ENV=production
HOST=127.0.0.1
PORT=8090

SOURCE_DATABASE_URL=postgres://finops_source_reader:REPLACE_WITH_SOURCE_READONLY_PASSWORD@127.0.0.1:5432/sub2api?sslmode=disable
FINOPS_DATABASE_URL=postgres://finops_target_writer:REPLACE_WITH_FINOPS_DATABASE_PASSWORD@127.0.0.1:5432/apistation_finops?sslmode=disable
SOURCE_STATEMENT_TIMEOUT_MS=10000
FINOPS_STATEMENT_TIMEOUT_MS=30000
FINOPS_SCHEMA=finops
SOURCE_SCHEMA=public
SOURCE_SETTINGS_SCHEMA=finops_source

SYNC_ENABLED=true
SYNC_USAGE_ENABLED=false
USAGE_DATA_MODE=source_api
SYNC_INTERVAL_SECONDS=60
SYNC_BATCH_SIZE=1000
SYNC_MAX_BATCHES_PER_CYCLE=3
SYNC_LOOKBACK_SECONDS=600
SUBSCRIPTIONS_ENABLED=false

BASE_CURRENCY=CNY
BILLING_UNIT=CNY
SOURCE_BALANCE_UNIT=CNY
TIMEZONE=Asia/Shanghai

AUTH_DISABLED=false
SUB2API_AUTH_URL=http://127.0.0.1:8080
SUB2API_AUTH_TIMEOUT_MS=10000
SUB2API_USAGE_TIMEOUT_MS=15000
SUB2API_USAGE_CACHE_TTL_SECONDS=30
SUB2API_USAGE_STALE_TTL_SECONDS=300
SUB2API_USAGE_MAX_CONCURRENCY=2
SUB2API_USAGE_ACCOUNT_FANOUT_LIMIT=20
RUNTIME_SNAPSHOT_INTERVAL_SECONDS=10
RUNTIME_LIVE_REFRESH_SECONDS=2
SUPPLIER_CREDENTIALS_KEY=REPLACE_WITH_32_RANDOM_BYTES_BASE64
SUPPLIER_BLOCKED_HOSTS=ai.apistation.net,38.49.216.189
SUPPLIER_MONITOR_INTERVAL_SECONDS=3
SUPPLIER_REQUEST_TIMEOUT_MS=10000
SUPPLIER_MAX_RESPONSE_BYTES=1048576
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
SESSION_TTL_SECONDS=43200
SESSION_COOKIE_SECURE=true
