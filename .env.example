NODE_ENV=production
HOST=0.0.0.0
PORT=8090

# Required in production. FinOps reads sub2api only through this separate
# read-only role. It must have no CREATE, INSERT, UPDATE or DELETE privileges.
SOURCE_DATABASE_URL=postgres://finops_source_reader:REPLACE_WITH_SOURCE_READONLY_PASSWORD@postgres:5432/sub2api?sslmode=disable
# Required in production. This must be a different PostgreSQL database from
# SOURCE_DATABASE_URL. All FinOps ledgers, costs and settings are stored here.
FINOPS_DATABASE_URL=postgres://finops_target_writer:REPLACE_WITH_FINOPS_DATABASE_PASSWORD@postgres:5432/apistation_finops?sslmode=disable
FINOPS_SCHEMA=finops
SOURCE_SCHEMA=public
# Admin-owned restricted view schema; never grant FinOps SELECT on public.settings.
SOURCE_SETTINGS_SCHEMA=finops_source

# Conservative defaults for a 2C4G server shared with sub2api.
SYNC_ENABLED=true
SYNC_INTERVAL_SECONDS=60
SYNC_BATCH_SIZE=1000
SYNC_MAX_BATCHES_PER_CYCLE=3
SYNC_LOOKBACK_SECONDS=600
# Current ApiStation billing is usage-based only. Enable only when the source
# instance actively uses user_subscriptions and exposes that table.
SUBSCRIPTIONS_ENABLED=false

# Configuration placeholder. Automatic detail cleanup is not enabled until a
# reviewed retention job is implemented; daily aggregates and ledgers are retained.
DETAIL_RETENTION_DAYS=180

# CNY is the only wallet, operating, revenue, cost and profit currency.
# total_cost/account_stats_cost are USD pricing references; only total_cost is
# retained as a Token list-price reference and neither may create CNY cost.
BASE_CURRENCY=CNY
BILLING_UNIT=CNY
SOURCE_BALANCE_UNIT=CNY

# Do not set UPSTREAM_USD_TO_CNY_RATE. Manual cost and cash entries are CNY-only;
# USD is retained only as a read-only Token list-price reference.
TIMEZONE=Asia/Shanghai

# Required in production. AUTH_DISABLED=true is for isolated local demo use only.
AUTH_DISABLED=false
# Local-only sub2api authentication service. FinOps posts credentials here and
# checks that the authenticated user has role=admin; it never reads password hashes.
SUB2API_AUTH_URL=http://127.0.0.1:8080
SUB2API_AUTH_TIMEOUT_MS=10000
# Dedicated Sub2API service-account credentials are configured and encrypted
# in FinOps from the "Sub2API 自动认证" control. FinOps stores no access token.
SUB2API_SERVICE_AUTH_REFRESH_SECONDS=300
SUB2API_RUNTIME_PAGE_SIZE=100

# Optional response cache. Use a non-default, FinOps-only Redis database.
# FinOps never uses FLUSHDB/FLUSHALL and never writes to Sub2API's Redis DB.
FINOPS_REDIS_URL=redis://:REPLACE_WITH_REDIS_PASSWORD@1Panel-redis-Ahn3:6379/15
FINOPS_REDIS_KEY_PREFIX=finops:cache:
FINOPS_REDIS_CONNECT_TIMEOUT_MS=1500
DASHBOARD_CACHE_TTL_SECONDS=5
LIST_CACHE_TTL_SECONDS=3
RUNTIME_CACHE_TTL_SECONDS=2

# Optional, read-only source Redis connection. This is used only for the
# Sub2API `concurrency:user:*` sorted sets and only sends ZRANGEBYSCORE/ZCOUNT.
# It never writes, expires, deletes or scans Sub2API application keys.
SUB2API_REDIS_URL=redis://:REPLACE_WITH_REDIS_PASSWORD@1Panel-redis-Ahn3:6379/0
SUB2API_REDIS_CONNECT_TIMEOUT_MS=1500
SUB2API_REDIS_RUNTIME_USER_LIMIT=500
SUB2API_REDIS_RUNTIME_ACCOUNT_LIMIT=500
# Refresh FinOps-owned concurrency snapshots independently from the heavier
# accounting sync. This remains read-only against the Sub2API Redis database.
RUNTIME_SNAPSHOT_INTERVAL_SECONDS=10
# Interactive runtime requests read the local Sub2API API and Redis directly.
# FinOps coalesces callers during this interval to protect the source service.
RUNTIME_LIVE_REFRESH_SECONDS=2

# Required to store supplier portal credentials. Generate a dedicated value
# with `openssl rand -base64 32`; never reuse SESSION_SECRET or commit the key.
SUPPLIER_CREDENTIALS_KEY=REPLACE_WITH_32_RANDOM_BYTES_BASE64
# Hard safety boundary: supplier monitoring will never connect to these hosts
# or to any hostname resolving to a listed IP. Include every public hostname
# and IP that can reach this installation's production Sub2API.
SUPPLIER_BLOCKED_HOSTS=ai.apistation.net,38.49.216.189
# Supplier checks are read-only: portal inventory, balance and non-billable
# token metadata/status endpoints. Full API keys are never stored by FinOps.
SUPPLIER_MONITOR_INTERVAL_SECONDS=3
SUPPLIER_REQUEST_TIMEOUT_MS=10000
SUPPLIER_MAX_RESPONSE_BYTES=1048576

# Required in production. Generate with: openssl rand -base64 48
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
SESSION_TTL_SECONDS=43200
SESSION_COOKIE_SECURE=true

# Comma-separated parent origins allowed to embed the public /monitor page.
# Keep this explicit; /monitor never permits arbitrary third-party framing.
# Example: https://sub2api.example.com,https://ops.example.com
MONITOR_EMBED_ORIGINS=

# Docker Compose only. Inspect the server and enter the exact existing network;
# there is intentionally no guessed default such as sub2api_default.
APISTATION_DOCKER_NETWORK=REPLACE_WITH_EXISTING_SUB2API_NETWORK
FINOPS_PORT=8090
