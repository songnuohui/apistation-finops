NODE_ENV=production
HOST=0.0.0.0
PORT=8090

# Required in production. Never use the PostgreSQL administrator account here.
# The service role must have column-level SELECT on the required public source fields,
# no access to accounts.credentials, and write access only to the finops schema.
DATABASE_URL=postgres://finops_app:REPLACE_WITH_SERVER_LOCAL_PASSWORD@postgres:5432/sub2api?sslmode=disable
FINOPS_SCHEMA=finops
SOURCE_SCHEMA=public
# Admin-owned restricted view schema; never grant FinOps SELECT on public.settings.
SOURCE_SETTINGS_SCHEMA=finops_source

# Conservative defaults for a 2C4G server shared with sub2api.
SYNC_ENABLED=true
SYNC_INTERVAL_SECONDS=60
SYNC_BATCH_SIZE=1000
SYNC_MAX_BATCHES_PER_CYCLE=3
SYNC_LOOKBACK_SECONDS=600

# Configuration placeholder. Automatic detail cleanup is not enabled until a
# reviewed retention job is implemented; daily aggregates and ledgers are retained.
DETAIL_RETENTION_DAYS=180

# CNY is the only wallet, operating, revenue, cost and profit currency.
# total_cost/account_stats_cost are USD pricing references; only total_cost is
# retained as a Token list-price reference and neither may create CNY cost.
BASE_CURRENCY=CNY
BILLING_UNIT=CNY
SOURCE_BALANCE_UNIT=CNY

# Do not set UPSTREAM_USD_TO_CNY_RATE. Manual cost and cash entries are CNY-only;
# USD is retained only as a read-only Token list-price reference.
TIMEZONE=Asia/Shanghai

# Required in production. AUTH_DISABLED=true is for isolated local demo use only.
AUTH_DISABLED=false
ADMIN_TOKEN=REPLACE_WITH_AT_LEAST_24_RANDOM_CHARACTERS

# Docker Compose only. Inspect the server and enter the exact existing network;
# there is intentionally no guessed default such as sub2api_default.
APISTATION_DOCKER_NETWORK=REPLACE_WITH_EXISTING_SUB2API_NETWORK
FINOPS_PORT=8090
